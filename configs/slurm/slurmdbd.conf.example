# Install only on the database/SlurmDBD host. Replace the password privately.
# This file contains a database credential and must never be committed.
AuthType=auth/munge
DbdHost=controller
DbdPort=6819
SlurmUser=slurm
DebugLevel=info
LogFile=/var/log/slurm/slurmdbd.log
PidFile=/run/slurm/slurmdbd.pid

StorageType=accounting_storage/mysql
StorageHost=localhost
StoragePort=3306
StorageUser=slurm
StoragePass=REPLACE_WITH_A_PRIVATE_SECRET
StorageLoc=slurm_acct_db
