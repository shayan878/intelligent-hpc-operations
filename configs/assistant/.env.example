# OpenAI-compatible API endpoint, including the /v1 path.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=your-served-model-name
# Optional. Leave empty for an endpoint that does not require authentication.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Exact Slurm node names permitted for drain/resume operations.
# Keep empty for read-only-only operation.
SLURM_ALLOWED_NODES=worker1,worker2
